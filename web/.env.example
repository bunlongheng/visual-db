# --- Required ---
# Postgres connection string for the database you want to profile (read-only).
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# --- Optional ---
# Alternate name for the connection string (also honored by the CLI, bin/dbchart).
# DBCHART_URL=postgres://user:password@localhost:5432/dbname

# If set, the web app REQUIRES this token. Unlock a browser once by visiting
# http://localhost:3000/?token=YOUR_TOKEN (the token is stored in an httpOnly cookie).
# API clients send it as `Authorization: Bearer YOUR_TOKEN`, `x-visual-db-token`, or `?token=`.
# Leave UNSET for local-only use with no auth. SET it before exposing the app on any host.
# VISUAL_DB_TOKEN=

# Minutes of inactivity before the browser is signed out automatically (default 15).
# Also the lifetime of the session token, so a closed tab expires on its own.
# IDLE_TIMEOUT_MINUTES=15

# Profile result cache TTL in milliseconds (default 60000; set 0 to disable caching).
# PROFILE_CACHE_TTL_MS=60000

# Set to 1 on a hosted demo deployment to show the "demo sandbox - synthetic data" badge.
# NEXT_PUBLIC_DEMO=1

# Stickies posting (local; minted per-machine, never commit a real key)
# STICKIES_API_BASE=http://localhost:4444
# STICKIES_TOKEN=
